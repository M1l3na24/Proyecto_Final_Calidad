    "features7 = feats7_present + ['pos_cod']\n",
    "\n",
    "df_p7 = df_p7.dropna(subset=feats7_present)\n",
    "df_p7['log_vm'] = np.log1p(df_p7['valor_mercado_eur'])\n",
    "\n",
    "X7 = df_p7[features7].values\n",
    "y7 = df_p7['log_vm'].values\n",
