    "ax1.plot(val_ca.index, val_ca.values, 'b-o', label='Cruz Azul', lw=2.5, ms=7)\n",
    "ax1.plot(val_am.index, val_am.values, 'y-s', label='América', lw=2.5, ms=7)\n",
    "ax1.plot(val_ray.index, val_ray.values, 'r-^', label='Rayados', lw=2.5, ms=7)\n",
    "ax1.set_title('Evolución del Valor Total de Plantilla', fontsize=13, fontweight='bold')\n",
