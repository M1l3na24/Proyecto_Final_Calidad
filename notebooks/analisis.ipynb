    "    ax1.set_title('P4.4: ¿Recibirá Tarjeta Roja?\\n(Matriz de Confusión)', fontweight='bold')\n",
    "\n",
    "    fpr44, tpr44, _ = roc_curve(y44_te, y44_prob)\n",
