    "    eq_disc['indice'] = eq_disc['amarillas'] + 3 * eq_disc['rojas']\n",
    "    eq_disc['am_x_jug'] = eq_disc['amarillas'] / eq_disc['jugadores']\n",
    "    eq_disc['roj_x_jug'] = eq_disc['rojas'] / eq_disc['jugadores']\n",
