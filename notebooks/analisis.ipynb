    "    x42 = x42.dropna(subset=[col_equipo_x])\n",
    "\n",
    "    eq_disc = x42.groupby(col_equipo_x).agg(\n",
    "        jugadores=(col_equipo_x, 'count'),\n",
    "        amarillas=(col_tam, 'sum'),\n",
    "        rojas=(col_troj, 'sum')\n",
    "    ).reset_index()\n",
