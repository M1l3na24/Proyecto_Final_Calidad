    "# D1.2 — Ventaja local por estadio (CSV)\n",
    "venues = (df_partidos_csv.groupby('venue').agg(\n",
    "    partidos=('match_id', 'count'),\n",
    "    goles_local_prom=('home_goals', 'mean'),\n",
