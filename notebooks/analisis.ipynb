    "ax1.bar(x - w/2, top20['Casa'], w, label='Casa', color='#2980B9', alpha=0.85)\n",
    "ax1.bar(x + w/2, top20['Fuera'], w, label='Fuera', color='#E74C3C', alpha=0.85)\n",
    "\n",
    "# resaltamos al cruz azul\n",
    "for i, team in enumerate(top20.index):\n",
